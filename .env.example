PORT=3000
PREFIX=.
OWNER_NUMBER=2348169946429
LOG_LEVEL=silent

# Optional thumbnail image shown on the .menu command. Leave blank for a text-only menu.
MENU_IMAGE_URL=

# Default .menu layout for accounts that haven't run .setmenustyle — classic, compact, or minimal
MENU_STYLE=classic

# Display name for the "forwarded from channel" tag on menu/ping
CHANNEL_NAME=NEXUS-MD Updates

# Auto-reject incoming calls to the linked account (can also be toggled live with .anticall on/off)
ANTICALL=true

# Force-join settings — leave as-is to use the defaults baked into src/config.js
FORCE_JOIN=true
FORCE_CHANNEL_LINK=https://whatsapp.com/channel/0029VbCoHP4Id7nGRtKYuA0A
FORCE_GROUP_LINK=https://chat.whatsapp.com/GMHYNRFJhyiFhM5h5tE0FX?s=cl&p=a&ilr=0

# Piped API base URL (optional; defaults to the public instance documented by Piped)
PIPED_API_URL=https://pipedapi.kavin.rocks
