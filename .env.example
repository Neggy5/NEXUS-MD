# Port the web pairing site + API listens on (Railway sets this automatically)
PORT=3000

# pino log level for Baileys (silent, error, warn, info, debug, trace)
LOG_LEVEL=silent

# WhatsApp number (digits only) allowed to run owner-only commands
OWNER_NUMBER=2348169946429

# Force-join gate
FORCE_CHANNEL_LINK=
FORCE_GROUP_LINK=
FORCE_JOIN=true

# Menu / branding
MENU_IMAGE_URL=
# MENU_IMAGE_URL accepts an https:// URL or a local file path, e.g. /app/public/menu.jpg
CHANNEL_NAME=NEXUS-MD 

ANTICALL=true
PREFIX=.
MENU_STYLE=classic

# ── Telegram pairing ────────────────────────────────────────────
# Optional. Leave blank to run web pairing only. Create a bot with
# @BotFather on Telegram to get a token — once set, /pair works in
# Telegram at the same time as the website, sharing the same sessions.
TELEGRAM_BOT_TOKEN=8607752844:AAE7C42gGlm5_FAumLN7uRL6xJfM5s8VAMU

# Telegram membership gate is hard-coded in src/config.js.
# No group/channel membership IDs or links are required here.
# Admin Telegram ID is hard-coded in src/config.js; no env value is required.

